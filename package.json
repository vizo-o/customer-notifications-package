{
    "name": "@vizo-o/customer-notifications",
    "version": "0.1.7",
    "description": "Customer notification templates (email, SMS, WATI metadata) for Vizo systems",
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "bin": {
        "notifications-compile": "./cli/compile-runner.mjs"
    },
    "files": [
        "dist",
        "cli"
    ],
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "default": "./dist/src/index.js"
        },
        "./layout": {
            "types": "./dist/src/email/layout.d.ts",
            "default": "./dist/src/email/layout.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "lint": "oxlint src test -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json",
        "lint:fix": "oxlint src test -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json --fix",
        "type-check": "tsc --noEmit",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "audit:high": "npm audit --audit-level=high",
        "prepublishOnly": "node scripts/prepublish-only.mjs",
        "pre-release": "node scripts/pre-release.mjs",
        "release": "release-it",
        "release:ci": "npm run pre-release && release-it --ci",
        "typecheck": "tsc --noEmit",
        "typecheck:native": "tsgo --noEmit 2>/dev/null || tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vizo-o/customer-notifications-package.git"
    },
    "author": "Gilaad Elstein",
    "license": "ISC",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "zod": "^3.23.0"
    },
    "dependencies": {
        "@react-email/components": "^0.0.31",
        "@react-email/render": "^1.0.4",
        "zod-to-json-schema": "^3.24.5"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.10",
        "@typescript/native-preview": "^7.0.0-dev",
        "@vizo-o/dev-tools": "^1.0.70",
        "jest": "^30.5.2",
        "oxlint": "^1.75.0",
        "prettier": "^3.4.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "release-it": "^19.0.3",
        "ts-jest": "^29.4.5",
        "typescript": "~5.8.2",
        "zod": "^3.24.2"
    },
    "overrides": {
        "lodash": ">=4.17.24",
        "brace-expansion": "5.0.12",
        "fast-xml-parser": ">=5.7.0",
        "minimatch": ">=10.2.1",
        "undici": ">=7.30.0 <8.0.0",
        "js-yaml": ">=5.2.2",
        "basic-ftp": "6.2.2",
        "@grpc/grpc-js": ">=1.14.5",
        "handlebars": "4.7.10"
    }
}
